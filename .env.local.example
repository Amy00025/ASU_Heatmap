# Google Maps API Key (Optional: fallback interactive heatmap view runs automatically if unprovided)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Session signing secret for local auth cookies (REQUIRED for production; recommended for local).
# Generate with: openssl rand -base64 32
# Never commit the real value — keep it only in your machine's .env.local
AUTH_SECRET=replace_with_a_long_random_string
